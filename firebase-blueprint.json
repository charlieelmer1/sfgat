{
  "entities": {
    "systemState": {
      "title": "System State",
      "description": "SFGA EMS Command Portal state including hours, roster, protocols, and logs",
      "type": "object",
      "properties": {
        "parkHours": { "type": "object" },
        "supervisor": { "type": "object" },
        "announcement": { "type": "string" },
        "predefinedSupervisorsList": { "type": "array" },
        "protocols": { "type": "array" },
        "sops": { "type": "array" },
        "roster": { "type": "array" },
        "contacts": { "type": "array" },
        "phoneExtensions": { "type": "array" },
        "tenCodes": { "type": "array" },
        "signals": { "type": "array" },
        "weeklySchedule": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "documentItem": {
      "title": "Document Item",
      "description": "SOP or Medical Direction protocol document stored and synchronized across all devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "attachmentName": { "type": "string" },
        "attachmentType": { "type": "string" },
        "attachmentData": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/system_state/current": {
      "entity": "systemState"
    },
    "/documents/{documentId}": {
      "entity": "documentItem"
    }
  }
}
